{# Optional. A download page for publishing the built book to GitHub Pages —
   rendered to build/index.html only because this theme ships the template; a
   theme that omits it simply produces no landing page.

   It lives here rather than in the core because it is a cover design, and the
   theme is what knows this book's palette by name. Sibling files are the build's
   own outputs, so the links are bare relative names. #}
<!doctype html>
<html lang="{{ book.language }}"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ book.title }}</title>
<style>
  body{margin:0;font-family:Georgia,serif;background:{{ book.palette.navy }};color:{{ book.palette.cream }};
       min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center}
  .card{max-width:640px;padding:3rem 1.5rem}
  h1{font-size:3rem;line-height:1.05;margin:0 0 .3rem} .the{font-style:italic;font-weight:400}
  p.sub{text-transform:uppercase;letter-spacing:.16em;font-size:.8rem;opacity:.85}
  .dl{display:inline-block;margin:.5rem;padding:.8rem 1.6rem;border:1px solid {{ book.palette.rule }};
       border-radius:4px;color:{{ book.palette.cream }};text-decoration:none;letter-spacing:.08em}
  .dl:hover{background:rgba(255,255,255,.08)}
  img{max-width:100%;margin-top:2rem;border-radius:4px;opacity:.95}
  .foot{margin-top:2rem;font-size:.75rem;opacity:.6}
</style></head><body><div class="card">
  <h1><span class="the">{{ book.title_article }}</span> {{ book.title_rest }}</h1>
{# Both are optional book metadata, so the separator and the label only appear
   with something to separate or label — the core used to print a bare
   "· Volume" on a book that set neither. #}
{% set parts = [book.subtitle, book.labels.volume ~ " " ~ book.volume if book.volume else ""] | select | list %}
{% if parts %}
  <p class="sub">{{ parts | join(" · ") }}</p>
{% endif %}
  <div>
    <a class="dl" href="cookbook.pdf">Download PDF</a>
    <a class="dl" href="cookbook.epub">Download EPUB</a>
  </div>
  <a href="cookbook.pdf"><img src="contact-sheet.png" alt="Preview of all pages"></a>
{% if book.rights or book.repo_url %}
  <p class="foot">{{ book.rights }}{% if book.rights and book.repo_url %} · {% endif %}
{%- if book.repo_url %}<a href="{{ book.repo_url }}" style="color:{{ book.palette.rule }}">Contribute a recipe</a>{% endif %}</p>
{% endif %}
</div></body></html>
