<!doctype html>
<html lang="{{ book.language }}">
<head>
<meta charset="utf-8">
<title>{{ book.title }}</title>
{% for href in css_links %}<link rel="stylesheet" href="{{ href }}">
{% endfor %}
{# The token block is ALWAYS LAST in the head. Theme defaults and book overrides
   are merged in Python and arrive here already resolved, so this is the only
   place the tokens are declared — but a stylesheet that declares `:root` too
   would have equal specificity, and the later rule wins. Emitted above the
   links, every book override was silently overwritten by the theme's own
   default. Keep it here. #}
<style>
{{ font_face_css }}
:root {
  --navy: {{ book.palette.navy }};
  --cream: {{ book.palette.cream }};
  --ink: {{ book.palette.ink }};
  --ink-deep: {{ book.palette.ink_deep }};
  --rule: {{ book.palette.rule }};
  --display: "{{ book.fonts.display }}", Georgia, serif;
  --body: "{{ book.fonts.body }}", Georgia, serif;
}
</style>
</head>
{# `sectioned` lets print.css nest each recipe under its section in the PDF
   outline. It has to key off the same flag as the openers: with no opener to sit
   under, a demoted recipe would nest beneath the introduction instead. #}
<body{% if book.section_openers %} class="sectioned"{% endif %}>

{# ---------- macros ---------- #}
{# The folio prints `counter(page)` (see print.css) rather than a number baked in
   here, so it is resolved by the same counter the contents page reads through
   `target-counter` — the printed number and the index entry cannot drift. Pages
   with no footer (cover, endpapers, contents, colophon) carry no folio, which is
   the conventional front-matter treatment. #}
{% macro footer(attribution="") -%}
<div class="footer">
  {% if attribution %}<div class="attribution">{{ attribution }}</div>{% endif %}
  <div class="folio"></div>
  <div class="mark"><span class="the">{{ book.title_article }}</span> {{ book.title_rest|upper }}</div>
</div>
{%- endmacro %}

{# Ingredients column body, shared by the story method page and the single page. #}
{% macro ingredients_col(r) -%}
<h2 class="label">{{ book.labels.ingredients }}</h2>
<div class="ing-body">{{ r.ingredients_html }}</div>
{% if r.servings %}
<div class="serves">
  <span class="label">{{ book.labels.yields }}</span>
  <span class="value">{{ r.servings }}</span>
</div>
{% endif %}
{% if r.notes_html %}
<div class="notes">
  <h2 class="label">{{ book.labels.notes }}</h2>
  <div class="prose">{{ r.notes_html }}</div>
</div>
{% endif %}
{% for s in r.extra_sections %}
<div class="notes extra">
  <h2 class="label">{{ s.title }}</h2>
  <div class="prose">{{ s.html }}</div>
</div>
{% endfor %}
{%- endmacro %}

{# Title, byline and rule — shared by all three recipe layouts so they cannot
   drift apart. An `author:` is a person who tells the story, so it is shown only
   on a recipe that has one; otherwise the byline falls back to `credits`, which
   is provenance. That is the same rule the method page's sidebar applies. #}
{% macro title_block(r) -%}
{% set show_author = r.has_story and r.author.name %}
<h1 id="{{ r.slug }}" class="display title {{ 'small' if r.title|length > 22 else '' }}">{{ r.title }}</h1>
{% if show_author or r.credits_line %}
<div class="recipe-by">
  <span class="label">{{ book.labels.recipe_by if show_author else book.labels.recipe_from }}</span>
  <span class="byline">
    {% if show_author %}<span class="name">{{ r.author.name }}</span>{% if r.author.org %} <span class="org">({{ r.author.org }})</span>{% endif %}
    {% else %}<span class="name">{{ r.credits_line }}</span>{% endif %}
  </span>
</div>
{% endif %}
<hr class="rule">
{%- endmacro %}

{# The two-column body, shared by the method page and the collapsed single page.
   A recipe whose author never wrote the method gets an explicit line where the
   steps would start: an empty labelled column beside a hairline divider reads as
   an unfinished page rather than as fidelity to the source. #}
{% macro columns(r) -%}
<div class="columns">
  <div class="col directions{% if not r.directions_html %} no-method{% endif %}">
    {% if r.directions_html %}
    <h2 class="label">{{ book.labels.directions }}</h2>
    <div class="steps">{{ r.directions_html }}</div>
    {% else %}
    <p class="no-method-note">{{ book.labels.no_method }}</p>
    {% endif %}
  </div>
  <div class="col ingredients">{{ ingredients_col(r) }}</div>
</div>
{%- endmacro %}

{# Full story page — used only when a recipe has a story to tell. #}
{% macro story_page(r) -%}
<section class="page cream recipe-head story">
  <div class="inner">
    {{ title_block(r) }}
    <div class="story">
      {% if r.headshot_url %}<img class="headshot" src="{{ r.headshot_url }}" alt="">{% endif %}
      <div class="prose">
        {% for p in r.story_html %}<p>{{ p }}</p>{% endfor %}
      </div>
    </div>
  </div>
  {% if r.illustration_url %}<img class="hero" src="{{ r.illustration_url }}" alt="">{% endif %}
  {{ footer(r.attribution) }}
</section>
{%- endmacro %}

{# Opener page for an illustrated recipe without a story: centred title + byline
   + a large centred hero. The directions/ingredients live on the method page. #}
{% macro opener_page(r) -%}
<section class="page cream recipe-head opener">
  <div class="inner">
    {{ title_block(r) }}
  </div>
  {% if r.illustration_url %}<img class="hero" src="{{ r.illustration_url }}" alt="">{% endif %}
  {{ footer(r.attribution) }}
</section>
{%- endmacro %}

{% macro method(r) -%}
<section class="page cream method">
  <div class="inner">
    {{ columns(r) }}
  </div>
  <div class="sidebar">
    <div class="sidebar-rot">
      <span class="s-title">{{ r.title }}</span>
      {% if (r.has_story and r.author.name) or r.credits_line %}
      <span class="s-by">{{ (book.labels.recipe_by + ' ' + r.author.name) if (r.has_story and r.author.name) else (book.labels.recipe_from + ' ' + r.credits_line) }}</span>
      {% endif %}
    </div>
  </div>
  {{ footer(r.attribution) }}
</section>
{%- endmacro %}

{# One recipe, one sheet — for a recipe with neither a story nor an illustration.
   The opener page exists to carry hero art; with no art and no story it would be
   a title alone on an otherwise blank sheet, one per recipe. Here the title block
   sits at the head of the same sheet as the columns instead. No rotated sidebar:
   it repeats a title that is now already on the page. #}
{% macro recipe_page(r) -%}
<section class="page cream recipe">
  <div class="inner">
    <div class="rhead">{{ title_block(r) }}</div>
    {{ columns(r) }}
  </div>
  {{ footer(r.attribution) }}
</section>
{%- endmacro %}

{# ---------- pages ---------- #}

<section class="page navy cover">
  <div class="panel">
    <div class="display title"><span class="article">{{ book.title_article }}</span>{{ book.title_rest }}</div>
    {% if book.subtitle %}<div class="subtitle">{{ book.subtitle }}</div>{% endif %}
    {# Guarded: `volume` is optional, and an unset one used to print the bare
       word "Volume" with nothing after it. #}
    {% if book.volume %}<div class="volume">{{ book.labels.volume }} {{ book.volume }}</div>{% endif %}
  </div>
</section>

<section class="page navy endpaper"></section>

{# Interior title page: the same title as the cover, set quietly on paper. Part
   of the front matter, so it carries no footer and takes no folio. #}
<section class="page cream title-page">
  <div class="inner">
    <div class="display title"><span class="article">{{ book.title_article }}</span>{{ book.title_rest }}</div>
    <hr class="rule">
    {% if book.subtitle %}<div class="tp-sub">{{ book.subtitle }}</div>{% endif %}
  </div>
</section>

{# Contents: `toc` is the grouping the core derived (build_html.build_toc) — not
   book.yaml's optional `sections:` key, which is undefined in most books and
   quietly printed an empty Contents page when this loop read it directly. Page
   numbers are resolved by WeasyPrint (target-counter) against each recipe
   opener's id. #}
<section class="page cream contents">
  <div class="inner">
    <h1 class="display title">{{ book.labels.contents }}</h1>
    <hr class="rule">
    <nav class="toc">
      {% for section in toc %}
      <div class="toc-section">
        <h2 class="toc-head">{{ section.title }}</h2>
        <ul class="toc-list">
          {% for r in section.recipes %}<li><a href="#{{ r.slug }}">{{ r.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </nav>
  </div>
  {# No running footer: the contents is the one page that flows and fragments
     across several sheets, and an absolutely-positioned footer would land on
     only one of them. Its per-sheet breathing room comes from padding on the
     page element instead (see print.css). #}
</section>

<section class="page cream intro">
  <div class="inner">
    <h1 class="display title">{{ intro.title }}</h1>
    {% if intro.from_name %}
    <div class="from">
      <span class="label">{{ book.labels.from }}</span><br>
      <span class="byline"><span class="name">{{ intro.from_name }}</span>{% if intro.from_org %} <span class="org">({{ intro.from_org }})</span>{% endif %}</span>
    </div>
    {% endif %}
    <hr class="rule">
    <div class="prose">{% for p in intro.body_html %}<p>{{ p }}</p>{% endfor %}</div>
  </div>
  {{ footer() }}
</section>

{# A full-bleed divider before the first recipe of each section, echoing the
   cover and endpapers. Opt-in (`section_openers: true`): a sheet per section is
   worth spending in a long book and crowds a short one, where the dividers can
   outnumber the recipes.

   `recipes` is already ordered so each section is contiguous, so emitting one
   whenever the category changes puts exactly one before each group — no
   hard-coded section list, and it follows if the sections are ever renamed.
   Openers carry no footer (so no folio) and hold no contents entry; the index
   resolves against recipe ids, so the extra sheets simply shift and re-resolve. #}
{% macro section_opener(name) -%}
<section class="page navy section-opener">
  <div class="panel">
    <hr class="rule">
    <h1 class="display title">{{ name }}</h1>
    <hr class="rule">
  </div>
</section>
{%- endmacro %}

{# Two pages when the recipe has something to fill an opener with — a story, or a
   hero illustration — and one page when it has neither. Keyed off the recipe's
   own content rather than a book-level setting, so an illustrated book keeps its
   spreads and a plain one stops paying a blank sheet per recipe. #}
{% set ns = namespace(section=None) %}
{% for r in recipes %}
{%- if book.section_openers and r.category != ns.section %}{% set ns.section = r.category %}
{{ section_opener(book.labels.section_names.get(r.category, r.category)) }}
{%- endif %}
{% if r.has_story %}{{ story_page(r) }}{{ method(r) }}
{% elif r.illustration_url %}{{ opener_page(r) }}{{ method(r) }}
{% else %}{{ recipe_page(r) }}{% endif %}
{% endfor %}

<section class="page navy endpaper"></section>

<section class="page navy colophon">
  <div class="inner">
    <div class="producer">{{ book.labels.produced_by }}<span class="name">{{ book.producer }}</span></div>
    <div class="copyright">{{ book.rights }}</div>
  </div>
</section>

</body>
</html>
